# ResumeFit environment configuration (Phase 1)
# Copy the per-app examples into real files:
#   backend/.env   <- copy from backend/.env.example
#   frontend/.env  <- copy from frontend/.env.example
#
# No API keys or secrets are required in Phase 1.

# --- Backend (backend/.env) ---
RESUMEFIT_MAX_UPLOAD_BYTES=5242880
RESUMEFIT_RESUME_TTL_SECONDS=3600
RESUMEFIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RESUMEFIT_LOG_LEVEL=info

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
