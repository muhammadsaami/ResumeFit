# ResumeFit backend configuration (Phase 1)
# Copy to .env and adjust as needed. No secrets are required for Phase 1.

# Maximum accepted upload size in bytes (default 5 MB).
RESUMEFIT_MAX_UPLOAD_BYTES=5242880

# How long temporary resume data is retained, in seconds (default 1 hour).
RESUMEFIT_RESUME_TTL_SECONDS=3600

# Comma-separated list of allowed CORS origins for local frontend development.
RESUMEFIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uvicorn / app log level.
RESUMEFIT_LOG_LEVEL=info
